action "Full Cleanup (Recommended)"
exec  pacman -Qdtq
exec  pacman -Rs --print libfoo libbar
exec  sudo -n -v
auth  password -> <wrong>
exec  su -s /usr/bin/true $USER
auth  password -> <wrong>
exec  su -s /usr/bin/true $USER
auth  password -> <wrong>
exec  su -s /usr/bin/true $USER
plan  10 steps
plan  1 "Auditing AUR packages…" inproc alwayslog cat=audit
plan  2 "Updating system with topgrade…" argv=topgrade -y --disable hyprpm sudo alwayslog cat=topgrade
plan  3 "Cleaning package cache…" argv=sudo paccache -r sudo cat=cleanup
plan  4 "Deleting entire package cache…" argv=sudo paccache -rk0 sudo confirm optional alwayslog cat=cleanup
plan  5 "Removing orphaned packages…" argv=sudo pacman -Rns --noconfirm libfoo libbar sudo confirm optional alwayslog cat=orphans
plan  6 "Cleaning AUR cache…" argv=yay -Sc --noconfirm cat=cleanup
plan  7 "Cleaning old temp files…" argv=sudo systemd-tmpfiles --clean sudo alwayslog cat=cleanup
plan  8 "Vacuuming logs…" argv=sudo journalctl --vacuum-time=2weeks sudo alwayslog cat=cleanup
plan  9 "Checking package integrity…" argv=sudo pacman -Qkq sudo cat=cleanup
plan  10 "Updating Hyprland plugins…" argv=hyprpm update cat=cleanup
step  1 running
exec  pacman -Qqm
out   1 1 foreign package(s) checked against the AUR: 0 high, 0 glance, 1 clean
out   1
out   1 Nothing flagged.
step  1 ok
step  2 skipped
step  3 skipped
step  4 skipped
step  5 skipped
log   audit OK: AUR audit
log   cleanup SKIP: Old package cache cleaned (sudo authentication failed)
log   cleanup SKIP: Entire package cache removed (sudo authentication failed)
log   orphans SKIP: Orphaned packages removed (sudo authentication failed)
log   topgrade SKIP: Topgrade completed (sudo authentication failed)
step  6 running
exec  yay -Sc --noconfirm
step  6 ok
step  7 skipped
step  8 skipped
step  9 skipped
log   cleanup SKIP: Temp files cleaned per tmpfiles.d rules (sudo authentication failed)
log   cleanup SKIP: Old logs removed (sudo authentication failed)
log   cleanup SKIP: Package integrity check completed (sudo authentication failed)
step  10 running
exec  hyprpm update
step  10 ok
end   outcome=completed errs=0 skipped=7
