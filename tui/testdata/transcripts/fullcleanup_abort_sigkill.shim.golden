action "Full Cleanup (Recommended)"
exec  pacman -Qdtq
exec  pacman -Qqm
exec  sudo -n -v
ask   "Proceed with full cleanup?" -> yes
plan  9 steps
plan  1 "Auditing AUR packages…" inproc alwayslog cat=audit
plan  2 "Updating system with topgrade…" argv=topgrade -y --disable hyprpm sudo alwayslog cat=topgrade
plan  3 "Cleaning package cache…" argv=sudo paccache -r sudo cat=cleanup
plan  4 "Deleting entire package cache…" argv=sudo paccache -rk0 sudo confirm optional alwayslog cat=cleanup
plan  5 "Cleaning AUR cache…" argv=yay -Sc --noconfirm cat=cleanup
plan  6 "Cleaning old temp files…" argv=sudo systemd-tmpfiles --clean sudo alwayslog cat=cleanup
plan  7 "Vacuuming logs…" argv=sudo journalctl --vacuum-time=2weeks sudo alwayslog cat=cleanup
plan  8 "Checking package integrity…" argv=sudo pacman -Qkq sudo cat=cleanup
plan  9 "Updating Hyprland plugins…" argv=hyprpm update cat=cleanup
step  1 running
out   1 1 foreign package(s) checked against the AUR: 0 high, 0 glance, 1 clean
out   1
out   1 Nothing flagged.
step  1 ok
log   audit OK: AUR audit
step  2 running
exec  topgrade -y --disable hyprpm
abort 2 "Updating system with topgrade…"
end   outcome=aborted errs=0 skipped=0
