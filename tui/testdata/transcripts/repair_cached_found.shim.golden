action "Repair broken packages"
exec  sudo -n -v
exec  sudo -n pacman -Qk
plan  1 steps
plan  1 "Reinstalling packages…" argv=sudo pacman -S --noconfirm foo baz sudo confirm optional alwayslog cat=cleanup
ask   "Reinstall 2 broken package(s)?" -> yes
step  1 running
exec  sudo -A pacman -S --noconfirm foo baz
step  1 ok
log   cleanup OK: Package repair completed
end   outcome=completed errs=0 skipped=0
