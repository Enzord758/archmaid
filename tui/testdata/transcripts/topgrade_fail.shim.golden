action "Run topgrade (system update)"
exec  sudo -n -v
plan  1 steps
plan  1 "Updating system with topgrade…" argv=topgrade -y sudo alwayslog cat=topgrade
step  1 running
exec  topgrade -y
out   1 error: failed to commit transaction (conflicting files)
out   1 ── Summary ──
out   1 System update: FAILED
step  1 failed
log   topgrade FAIL: Topgrade completed
end   outcome=completed errs=1 skipped=0
