action "Run topgrade (system update)"
exec  sudo -n -v
auth  password -> <correct>
exec  su -s /usr/bin/true $USER
exec  sudo -S -v
plan  2 steps
plan  1 "Auditing AUR packages…" inproc alwayslog cat=audit
plan  2 "Updating system with topgrade…" argv=topgrade -y --no-retry sudo alwayslog cat=topgrade
step  1 running
out   1 No foreign (AUR or locally built) packages installed — nothing to audit.
step  1 ok
log   audit OK: AUR audit
step  2 running
exec  topgrade -y --no-retry
out   2 :: Synchronizing package databases...
out   2 ── Summary ──
out   2 System update: OK
step  2 ok
log   topgrade OK: Topgrade completed
end   outcome=completed errs=0 skipped=0
