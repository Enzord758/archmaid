action "Full Cleanup (Recommended)"
exec  pacman -Qqm --color never
ask   "Proceed with full cleanup?" -> yes
plan  8 steps
plan  1 "Auditing AUR packages…" inproc alwayslog cat=audit
plan  2 "Updating system with topgrade…" argv=topgrade -y --no-retry --disable hyprpm sudo alwayslog cat=topgrade
plan  3 "Cleaning package cache…" argv=sudo paccache -r sudo cat=cleanup
plan  4 "Finding orphaned packages…" inproc cat=orphans
plan  5 "Cleaning AUR cache…" argv=yay -Sc --noconfirm --color always cat=cleanup
plan  6 "Cleaning old temp files…" argv=sudo systemd-tmpfiles --clean sudo alwayslog cat=cleanup
plan  7 "Vacuuming logs…" argv=sudo journalctl --vacuum-time=2weeks sudo alwayslog cat=cleanup
plan  8 "Checking package integrity…" argv=sudo pacman -Qkq sudo cat=cleanup
step  1 running
out   1 No foreign (AUR or locally built) packages installed — nothing to audit.
step  1 ok
log   audit DRYRUN: AUR audit
step  2 running
out   2 [dry-run] would run: topgrade -y --no-retry --disable hyprpm
step  2 ok
log   topgrade DRYRUN: Topgrade completed
step  3 running
out   3 [dry-run] would run: sudo paccache -r
step  3 ok
log   cleanup DRYRUN: Old package cache cleaned
step  4 running
exec  pacman -Qdtq --color never
out   4 No orphaned packages.
step  4 ok
log   orphans DRYRUN: Orphaned packages checked
step  5 running
out   5 [dry-run] would run: yay -Sc --noconfirm --color always
step  5 ok
log   cleanup DRYRUN: AUR cache cleaned
step  6 running
out   6 [dry-run] would run: sudo systemd-tmpfiles --clean
step  6 ok
log   cleanup DRYRUN: Temp files cleaned per tmpfiles.d rules
step  7 running
out   7 [dry-run] would run: sudo journalctl --vacuum-time=2weeks
step  7 ok
log   cleanup DRYRUN: Old logs removed
step  8 running
out   8 [dry-run] would run: sudo pacman -Qkq
step  8 ok
log   cleanup DRYRUN: Package integrity check completed
end   outcome=completed errs=0 skipped=0
