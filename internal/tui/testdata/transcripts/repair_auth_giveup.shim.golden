action "Repair broken packages"
exec  pacman -Qq
exec  pacman -Qkq -- amd-ucode baz
exec  pacman -Qkq -- foo glibc
exec  sudo -n -v
auth  password -> <wrong>
exec  su -s /usr/bin/true $USER
auth  password -> <wrong>
exec  su -s /usr/bin/true $USER
auth  password -> <wrong>
exec  su -s /usr/bin/true $USER
log   repair FAIL: Sudo authentication failed — can't scan for broken packages.
note  "Sudo authentication failed — can't scan for broken packages."
end   outcome=notice errs=0 skipped=0
