action "Full Cleanup (Recommended)"
exec  pacman -Qqm
exec  sudo -n -v
ask   "Proceed with full cleanup?" -> yes
plan  10 steps
plan  1 "Auditing AUR packages…" inproc alwayslog cat=audit
plan  2 "Updating system with topgrade…" argv=topgrade -y --disable hyprpm sudo alwayslog cat=topgrade
plan  3 "Cleaning package cache…" argv=sudo paccache -r sudo cat=cleanup
plan  4 "Deleting entire package cache…" argv=sudo paccache -rk0 sudo confirm optional alwayslog cat=cleanup
plan  5 "Finding orphaned packages…" inproc cat=orphans
plan  6 "Cleaning AUR cache…" argv=yay -Sc --noconfirm --color always cat=cleanup
plan  7 "Cleaning old temp files…" argv=sudo systemd-tmpfiles --clean sudo alwayslog cat=cleanup
plan  8 "Vacuuming logs…" argv=sudo journalctl --vacuum-time=2weeks sudo alwayslog cat=cleanup
plan  9 "Checking package integrity…" argv=sudo pacman -Qkq sudo cat=cleanup
plan  10 "Updating Hyprland plugins…" argv=hyprpm update cat=cleanup
step  1 running
out   1 1 foreign package(s) checked against the AUR: 0 high, 0 glance, 1 clean
out   1
out   1 Nothing flagged.
step  1 ok
log   audit OK: AUR audit
step  2 running
exec  topgrade -y --disable hyprpm
out   2 :: Synchronizing package databases...
out   2 ── Summary ──
out   2 System update: OK
step  2 ok
log   topgrade OK: Topgrade completed
step  3 running
exec  sudo -A paccache -r
step  3 ok
ask   "Delete ENTIRE package cache? (can't reinstall without internet)" -> no
step  4 skipped
log   cleanup SKIP: Entire package cache removed (declined)
step  5 running
exec  pacman -Qdtq
exec  pacman -Rs --print -- libfoo libbar
out   5 2 orphaned package(s): libfoo libbar
out   5 pacman -Rns would remove 3 package(s):
out   5   libfoo
out   5   libbar
out   5   libbaz
step  5 ok
plan  11 steps
plan  +6 "Removing orphaned packages…" argv=sudo pacman -Rns --noconfirm -- libfoo libbar sudo confirm optional alwayslog cat=orphans
ask   "Remove 2 orphaned package(s) — 3 total once dependencies cascade?" -> yes
step  6 running
exec  sudo -A pacman -Rns --noconfirm -- libfoo libbar
step  6 ok
log   orphans OK: Orphaned packages removed
step  7 running
exec  yay -Sc --noconfirm --color always
out   7 error: could not access cache directory
step  7 failed
log   cleanup FAIL: AUR cache cleaned
step  8 running
exec  sudo -A systemd-tmpfiles --clean
step  8 ok
log   cleanup OK: Temp files cleaned per tmpfiles.d rules
step  9 running
exec  sudo -A journalctl --vacuum-time=2weeks
step  9 ok
log   cleanup OK: Old logs removed
step  10 running
exec  sudo -A pacman -Qkq
step  10 ok
step  11 running
exec  hyprpm update
step  11 ok
end   outcome=completed errs=1 skipped=1
