action "Clear caches"
exec  paccache --nocolor -dk0
row   ~/.cache — 3 MiB |
row   Entire package cache — 412 MiB (2 files) | Can't reinstall or downgrade those packages without internet
pick  [~/.cache pkgcache] -> [pkgcache]
exec  sudo -n -v
auth  password -> <correct>
exec  su -s /usr/bin/true $USER
exec  sudo -S -v
exec  sudo -n -v
plan  1 steps
plan  1 "Deleting entire package cache…" argv=sudo paccache -rk0 sudo optional alwayslog cat=cleanup
log   cleanup CHECK: Measured the caches: ~/.cache 3 MiB; package cache 412 MiB, 2 files.
step  1 running
exec  sudo -A paccache -rk0
step  1 ok
log   cleanup OK: Entire package cache removed
end   outcome=completed errs=0 skipped=0
