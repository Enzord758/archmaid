action "Clear caches"
exec  paccache --nocolor -dk0
row   ~/.cache — 3 MiB | Hidden files are kept
row   Entire package cache | Empty: nothing to delete | disabled
pick  [~/.cache pkgcache] -> [~/.cache pkgcache]
plan  1 steps
plan  1 "Cleaning user cache…" argv=bash -c rm -rf "$HOME/.cache/"* alwayslog cat=cleanup
log   cleanup CHECK: Measured the caches: ~/.cache 3 MiB; package cache 0 B, 0 files.
step  1 running
step  1 ok
log   cleanup OK: User cache cleared
end   outcome=completed errs=0 skipped=0
