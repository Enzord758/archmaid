action "Repair broken packages"
exec  pacman -Qq
exec  pacman -Qkq -- amd-ucode baz
exec  pacman -Qkq -- foo glibc
exec  sudo -n -v
exec  sudo -n pacman -Qkq -- amd-ucode baz foo
plan  1 steps
plan  1 "Reinstalling packages…" argv=sudo pacman -S --noconfirm -- baz foo sudo confirm optional alwayslog cat=cleanup
ask   "Reinstall 2 broken package(s)?" -> yes
step  1 running
exec  sudo -A pacman -S --noconfirm -- baz foo
step  1 ok
log   cleanup OK: Package repair completed
end   outcome=completed errs=0 skipped=0
